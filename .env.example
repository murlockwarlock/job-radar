APP_ENV=development
APP_NAME=job-radar
LOG_LEVEL=INFO
API_KEY=
API_DOCS_ENABLED=true

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://jobradar:change-me@postgres:5432/jobradar
DATABASE_SYNC_URL=postgresql+psycopg2://jobradar:change-me@postgres:5432/jobradar
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_LOCK_TTL_SECONDS=1800

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_POLLING_ENABLED=true
SEND_NOTIFICATIONS_ON_INITIAL_SYNC=false

HH_ACCESS_TOKEN=
HH_USER_AGENT=job-radar/0.1.0 (admin@example.com)
HH_API_BASE_URL=https://api.hh.ru
HH_REQUEST_TIMEOUT_SECONDS=20
HH_MIN_REQUEST_INTERVAL_SECONDS=1.0
HH_PER_PAGE=100
HH_MAX_PAGES=20

DEFAULT_POLLING_INTERVAL_SECONDS=900
SCHEDULER_DISPATCH_INTERVAL_SECONDS=30
DEFAULT_TIMEZONE=UTC
